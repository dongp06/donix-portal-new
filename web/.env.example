# Public site URL — cần set khi deploy để canonical / OG / sitemap đúng domain (vd https://donix.net)
# NEXT_PUBLIC_SITE_URL=https://donix.net

# Backend origin for Next.js rewrites (dev: start API first on this port)
API_URL=http://localhost:3001

# Cùng SQLite với API (đường dẫn tương đối khi chạy `next` từ thư mục web/)
DATABASE_URL="file:../api/prisma/dev.db"

# Trùng với ADMIN_API_KEY trên API nếu bạn bật khóa admin (Next gửi header x-admin-key)
# NEXT_PUBLIC_ADMIN_API_KEY=
