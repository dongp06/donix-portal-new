{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "git status",
			"type": "shell",
			"command": "git status --short; git log --oneline -5",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "fastify verify",
			"type": "shell",
			"command": "npm.cmd run verify:fastify",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "fastify typecheck",
			"type": "shell",
			"command": "npm.cmd run typecheck:fastify",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "fastify contract tests",
			"type": "shell",
			"command": "npm.cmd run test:fastify",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "fastify build",
			"type": "shell",
			"command": "npm.cmd run build:fastify",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "web typecheck",
			"type": "shell",
			"command": "npm.cmd run typecheck:web",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "web production build",
			"type": "shell",
			"command": "npm.cmd run build -w web",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Prisma generate",
			"type": "shell",
			"command": "npx.cmd prisma generate --schema api/prisma/schema.prisma",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Prisma migration status",
			"type": "shell",
			"command": "npx.cmd prisma migrate status --schema api/prisma/schema.prisma",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Prisma seed",
			"type": "shell",
			"command": "npx.cmd prisma db seed --schema api/prisma/schema.prisma",
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "E2EE WASM smoke",
			"type": "shell",
			"command": "npm.cmd run e2ee:wasm:smoke",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "legacy runtime audit",
			"type": "shell",
			"command": "rg -n \"@nestjs/common|@nestjs/core|@nestjs/platform-express|Express.Request|Express.Response|from ['\\\"]express|Multer\" apps api web --glob '!**/dist/**' --glob '!**/.next/**'",
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "list API processes",
			"type": "shell",
			"command": "Get-CimInstance Win32_Process -Filter \"Name='node.exe'\" | Where-Object { $_.CommandLine -match 'webthuebot|api-fastify' } | Select-Object ProcessId,CommandLine | Format-List",
			"problemMatcher": [],
			"group": "build"
		}
	]
}
