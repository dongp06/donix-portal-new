generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String      @id
  googleId   String?     @unique
  name       String
  email      String      @unique
  avatar     String
  role       String      @default("buyer")
  isVerified Boolean     @default(false)
  bio        String?
  joinedDate String
  contact    String?
  forumPosts ForumPost[]
}

model Category {
  id       String  @id
  slug     String  @unique
  name     String
  navLabel String?
  posts    Post[]
}

model Post {
  id              String   @id
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  coverImage      String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryName    String
  views           Int      @default(0)
  date            String
  isPinned        Boolean  @default(false)
  readTimeMinutes Int?
  stackLabel      String?
  tagLine         String?
  codeExample     String?
  sampleOutput    String?
  attachments     String?
  relatedSlugs    String?

  @@index([categoryId])
  @@index([date])
  @@index([isPinned])
}

model Bot {
  id            String   @id
  slug          String   @unique
  title         String
  tagline       String
  description   String
  categorySlug  String
  categoryName  String
  sellerId      String
  sellerName    String
  sellerAvatar  String
  sellerRating  Float    @default(0)
  sellerSales   Int      @default(0)
  sellerVerified Boolean @default(false)
  sellerJoinedDate String
  contactZalo   String?
  contactTelegram String?
  contactPhone  String?
  contactMessenger String?
  contactFacebook String?
  coverImage    String
  gallery       String   @default("[]")
  features      String   @default("[]")
  priceHourly   Int      @default(0)
  priceDaily    Int      @default(0)
  priceMonthly  Int      @default(0)
  status        String   @default("online")
  rating        Float    @default(5)
  reviewCount   Int      @default(0)
  tags          String   @default("[]")
  version       String   @default("v1.0.0")
  systemReqs    String   @default("")
  updatedAt     String

  @@index([categorySlug])
  @@index([sellerId])
}

model ForumPost {
  id           String @id
  title        String
  excerpt      String
  content      String
  authorId     String?
  author       User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String
  authorAvatar String
  authorRole   String @default("Người mua")
  category     String
  upvotes      Int    @default(0)
  commentsCount Int   @default(0)
  createdAt    String
  tags         String @default("[]")
  isPinned     Boolean @default(false)

  @@index([authorId])
  @@index([category])
}
