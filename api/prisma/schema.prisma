generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id         String      @id
  googleId   String?     @unique
  name       String
  email      String      @unique
  avatar     String
  role       String      @default("buyer")
  isVerified Boolean     @default(false)
  bio        String?
  joinedDate String
  contact    String?
  tier        String  @default("new")
  trustScore  Int     @default(0)
  trustScoreUpdatedAt String?
  forumPosts ForumPost[]
  comments   Comment[]
  reactions  Reaction[]
  reviews    BotReview[]
  sellerProfile  SellerProfile?
  verifications  TrustVerification[]
  trustEvents    TrustEvent[]
}

model Category {
  id       String  @id
  slug     String  @unique
  name     String
  navLabel String?
  posts    Post[]
}

model Post {
  id              String   @id
  slug            String   @unique
  title           String
  excerpt         String
  content         String
  coverImage      String
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryName    String
  views           Int      @default(0)
  date            String
  isPinned        Boolean  @default(false)
  readTimeMinutes Int?
  stackLabel      String?
  tagLine         String?
  codeExample     String?
  sampleOutput    String?
  attachments     String?
  relatedSlugs    String?

  @@index([categoryId])
  @@index([date])
  @@index([isPinned])
}

model Bot {
  id            String   @id
  slug          String   @unique
  title         String
  tagline       String
  description   String
  categorySlug  String
  categoryName  String
  sellerId      String
  sellerName    String
  sellerAvatar  String
  sellerRating  Float    @default(0)
  sellerSales   Int      @default(0)
  sellerVerified Boolean @default(false)
  sellerJoinedDate String
  contactZalo   String?
  contactTelegram String?
  contactPhone  String?
  contactMessenger String?
  contactFacebook String?
  coverImage    String
  gallery       String   @default("[]")
  features      String   @default("[]")
  priceHourly   Int      @default(0)
  priceDaily    Int      @default(0)
  priceMonthly  Int      @default(0)
  status        String   @default("online")
  rating        Float    @default(5)
  reviewCount   Int      @default(0)
  views         Int      @default(0)
  tags          String   @default("[]")
  version       String   @default("v1.0.0")
  systemReqs    String   @default("")
  updatedAt     String
  sellerSlug    String   @default("")
  reviews       BotReview[]

  @@index([categorySlug])
  @@index([sellerId])
}

model BotReview {
  id        String @id
  botId     String
  bot       Bot    @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  images    String @default("[]")
  createdAt String

  @@index([botId])
  @@index([userId])
}

model ForumPost {
  id           String @id
  title        String
  excerpt      String
  content      String
  authorId     String?
  author       User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName   String
  authorAvatar String
  authorRole   String @default("Người mua")
  category     String
  upvotes      Int    @default(0)
  commentsCount Int   @default(0)
  createdAt    String
  tags         String @default("[]")
  isPinned     Boolean @default(false)

  @@index([authorId])
  @@index([category])
}

model Comment {
  id          String     @id
  targetType  String
  targetId    String
  parentId    String?
  parent      Comment?   @relation("CommentTree", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]  @relation("CommentTree")
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  authorAvatar String
  content     String
  reactions   String     @default("[]")
  createdAt   String

  @@index([targetType, targetId])
  @@index([parentId])
  @@index([authorId])
}

model Reaction {
  id         String @id
  targetType String
  targetId   String
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  String

  @@unique([targetType, targetId, userId, emoji])
  @@index([targetType, targetId])
}

model SellerProfile {
  id                  String   @id
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopName            String
  slug                String   @unique
  bio                 String?
  avatar              String?
  banner              String?
  contact             String   @default("{}")
  profileCompleteness Int      @default(0)
  updatedAt           String
}

model TrustVerification {
  id          String  @id
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String
  note        String?
  submittedAt String
  reviewedAt  String?
  reviewedBy  String?
  expiresAt   String?

  @@index([userId])
  @@index([status])
}

model TrustEvent {
  id        String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  detail    String @default("{}")
  createdAt String

  @@index([userId])
}
