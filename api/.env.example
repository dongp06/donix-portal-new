# Prisma SQLite (file nằm trong api/prisma/dev.db khi DATABASE_URL như dưới)
DATABASE_URL="file:./prisma/dev.db"

# Redis — cache HTML bài viết (/api/posts/rendered/:slug). Bỏ trống = cache trong RAM.
# REDIS_URL="redis://127.0.0.1:6379"

# --- Google OAuth (đăng nhập bằng Google) ---
# Tạo tại https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID — Web application)
# Authorized JavaScript origins: http://localhost:3000
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Pure Fastify runtime
FASTIFY_HOST="0.0.0.0"
FASTIFY_PORT="3002"
PUBLIC_ORIGIN="http://localhost:3000"

# Production-only security material. Use a secret manager; never commit the
# real values. THB_TRANSPORT_PRIVATE_JWK must be a stable P-256 private JWK.
SECURITY_IP_SALT=""
THB_TRANSPORT_PRIVATE_JWK=""
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# Production browser cookie mutations require Origin by default. Keep false
# only for local/native compatibility clients that already use device proof.
TB_REQUIRE_MUTATION_ORIGIN="false"

# Bí mật ký JWT phiên đăng nhập (đổi sang chuỗi ngẫu nhiên khi deploy)

# --- CORS: danh sách origin được phép gọi API (phân tách bằng dấu phẩy) ---
# Mặc định (bỏ trống): http://localhost:3000
# CORS_ORIGINS="http://localhost:3000,https://donix.vn"
