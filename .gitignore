# Bootstrap marker
.bootstrap-complete

# Dependencies
node_modules/

# Environment (commit only *.example)
.env
.env.local
.env.*.local
!.env.example
!api/.env.example
!web/.env.example

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Logs & debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE (optional: track .vscode/extensions.json via !)
.idea/
*.swp
*.swo

# Local SQLite / Prisma (dev DB)
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Test coverage
coverage/
.nyc_output/

# Deploy / cache
.vercel
.turbo

# Misc
*.pem
.cache/

# Local Build Shield master/signing material and active build pointer
.build-shield/

# Claude agent cache
.agent/
.claude/

# Local file uploads
uploads/

# Rust/WASM build cache; the generated browser package is kept separately.
e2ee/wasm/target/

# Compiled shared/ (build artifacts, not source)
shared/*.js
shared/*.js.map
shared/*.d.ts
